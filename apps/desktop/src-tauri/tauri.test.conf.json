{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearth Preview",
  "version": "0.3.1",
  "identifier": "chat.hearth.preview",
  "app": {
    "windows": [
      {
        "title": "Hearth Preview",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KBHarris/hearth/releases/latest/download/latest.json"
      ]
    }
  }
}
