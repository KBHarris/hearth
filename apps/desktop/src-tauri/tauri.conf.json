{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearth",
  "version": "0.1.0",
  "identifier": "chat.hearth.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @hearth/client",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @hearth/client",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hearth",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' http: https: ws: wss:; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["hearth"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCODNEMTI4NjRCQzBEOTYKUldTV0RieGtLTkdEeTB4YzlCbGxnQjJRWGxsTENnTjRwK1dta2owWTJRUk15S0pvVjVySUZySWwK",
      "endpoints": [
        "https://github.com/KBHarris/hearth/releases/latest/download/latest-stable.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
