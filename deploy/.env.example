# Run node deploy/setup.mjs to generate deploy/.env. Never commit deploy/.env.

# Public domain of this server (used for discovery and federation).
HEARTH_SERVER_NAME=localhost
HEARTH_PORT=8080
# Loopback for initial setup. Configure TLS and an explicit bind before public hosting.
HEARTH_HOST=127.0.0.1
# Optional public IPv4 or DNS name, without scheme/port/path. Used by --https.
# Example only: replace with your actual WAN address before public startup.
HEARTH_PUBLIC_ADDRESS=
HEARTH_FEDERATION=false
# Exact web client origins. Use HTTPS for public hosting; no credentialed cookies.
HEARTH_CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://tauri.localhost,tauri://localhost
RUST_LOG=info

# setup.mjs replaces this placeholder with 32 random bytes encoded as hex.
POSTGRES_PASSWORD=change-me

# setup.mjs generates S3 access/secret keys and private s3.json on first initialization.
# Public files use this loopback endpoint locally, or the HTTPS proxy with --https.
HEARTH_S3_PORT=8333
HEARTH_S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
